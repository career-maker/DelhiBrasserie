{
  "name": "delhi-brasserie",
  "version": "1.0.0",
  "private": true,
  "description": "The Delhi Brasserie website",
  "scripts": {
    "build": "npm run build:css && npm run build:html",
    "build:css": "sass assets/scss/main.scss assets/css/main.min.css --style=compressed --source-map --no-charset",
    "build:html": "node build.mjs",
    "watch": "sass --watch assets/scss/main.scss assets/css/main.min.css --style=expanded --source-map",
    "watch:html": "node --watch-path=src --watch-path=build.mjs build.mjs",
    "serve": "python -m http.server 8000"
  },
  "devDependencies": {
    "sass": "^1.80.0",
    "sharp": "^0.35.4"
  }
}
